# =============================================================
# 環境変数のサンプル（値はすべてダミー）
#
# このリポジトリは Netlify の manual deploy 構成のため、本番の値は
# .env ではなく Netlify UI 側に設定する:
#   Site configuration → Environment variables
#
# このファイルは「どの変数が必要か」の一覧であり、ローカルで
# `netlify dev` を使う場合のみ .env にコピーして利用する。
# .env は絶対にコミットしないこと（.gitignore 済み）。
# =============================================================

# 実在の値に見える文字列はシークレットスキャンに検出されるため、
# ここでは山括弧のプレースホルダのみを置く。

# Slack 通知用 Incoming Webhook（既存 / netlify/functions/slack.js）
SLACK_WEBHOOK_URL=<slack-incoming-webhook-url>

# Notion 連携（netlify/functions/notion-intake.js）
# NOTION_TOKEN は Netlify では「Contains secret values」を有効にして登録する
NOTION_TOKEN=<notion-internal-integration-token>
# 問い合わせ登録先データベースID（DB URL の32桁部分。ビューIDの v= ではない）
NOTION_INTAKE_DB_ID=<notion-database-id-32-chars>
